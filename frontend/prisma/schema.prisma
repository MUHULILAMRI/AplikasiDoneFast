generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  password_hash String
  role          UserRole       @default(CUSTOMER)
  avatar        String?
  phone         String?
  balance       Decimal        @default(0)
  is_vip        Boolean        @default(false)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  sent_messages ChatMessage[]
  joki_profile  JokiMember?
  notifications Notification[]
  orders        Order[]
  referred_by   Referral?      @relation("referred")
  referrals     Referral[]     @relation("referrer")
  transactions  Transaction[]

  @@map("users")
}

model Service {
  id             String          @id @default(cuid())
  name           String
  description    String
  category       ServiceCategory
  base_price     Decimal
  rating         Float           @default(0)
  total_orders   Int             @default(0)
  estimated_days Int
  image          String?
  features       String[]
  is_popular     Boolean         @default(false)
  is_active      Boolean         @default(true)
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt
  orders         Order[]

  @@map("services")
}

model Order {
  id             String          @id @default(cuid())
  order_number   String          @unique
  user_id        String
  service_id     String
  joki_id        String?
  title          String
  description    String
  requirements   String
  files          String[]
  deadline       DateTime
  price          Decimal
  status         OrderStatus     @default(WAITING_FOR_QUOTE)
  difficulty     DifficultyLevel @default(MEDIUM)
  pages          Int?
  revisions_left Int             @default(2)
  result_files   String[]
  voucher_id     String?
  discount       Decimal         @default(0)
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt
  progress       Int             @default(0)
  has_journal    Boolean?        @default(true)
  urgency_level  String          @default("STANDAR")
  customer_rating  Int?
  customer_review  String?
  messages       ChatMessage[]
  joki           JokiMember?     @relation(fields: [joki_id], references: [id])
  service        Service         @relation(fields: [service_id], references: [id])
  user           User            @relation(fields: [user_id], references: [id])
  voucher        Voucher?        @relation(fields: [voucher_id], references: [id])
  transactions   Transaction[]

  @@map("orders")
}

model JokiMember {
  id              String   @id @default(cuid())
  user_id         String   @unique
  name            String
  skills          String[]
  rating          Float    @default(0)
  total_completed Int      @default(0)
  commission_rate Float    @default(50)
  is_available    Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  user            User     @relation(fields: [user_id], references: [id])
  orders          Order[]

  @@map("joki_members")
}

model ChatMessage {
  id          String   @id @default(cuid())
  order_id    String
  sender_id   String
  sender_role UserRole
  message     String
  file_url    String?
  is_read     Boolean  @default(false)
  created_at  DateTime @default(now())
  order       Order    @relation(fields: [order_id], references: [id])
  sender      User     @relation(fields: [sender_id], references: [id])

  @@map("chat_messages")
}

model Transaction {
  id             String        @id @default(cuid())
  order_id       String
  user_id        String
  amount         Decimal
  payment_method PaymentMethod
  payment_status PaymentStatus @default(PENDING)
  payment_url    String?
  external_id    String?
  paid_at        DateTime?
  created_at     DateTime      @default(now())
  order          Order         @relation(fields: [order_id], references: [id])
  user           User          @relation(fields: [user_id], references: [id])

  @@map("transactions")
}

model Voucher {
  id               String   @id @default(cuid())
  code             String   @unique
  discount_percent Float    @default(0)
  discount_amount  Decimal  @default(0)
  min_order        Decimal  @default(0)
  max_discount     Decimal  @default(0)
  valid_until      DateTime
  usage_count      Int      @default(0)
  max_usage        Int      @default(100)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
  orders           Order[]

  @@map("vouchers")
}

model Notification {
  id         String           @id @default(cuid())
  user_id    String
  title      String
  message    String
  type       NotificationType
  is_read    Boolean          @default(false)
  created_at DateTime         @default(now())
  user       User             @relation(fields: [user_id], references: [id])

  @@map("notifications")
}

model Referral {
  id          String   @id @default(cuid())
  referrer_id String
  referred_id String   @unique
  reward      Decimal  @default(0)
  is_claimed  Boolean  @default(false)
  created_at  DateTime @default(now())
  referred    User     @relation("referred", fields: [referred_id], references: [id])
  referrer    User     @relation("referrer", fields: [referrer_id], references: [id])

  @@map("referrals")
}

model SiteSettings {
  key        String   @id
  value      String
  updated_at DateTime @updatedAt

  @@map("site_settings")
}

enum UserRole {
  CUSTOMER
  ADMIN
  JOKI
}

enum ServiceCategory {
  AKADEMIK
  ARSITEKTUR
  CODING
  KONSULTASI
  AI_TEKNOLOGI
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  IN_PROGRESS
  REVISION
  COMPLETED
  CANCELLED
  WAITING_FOR_QUOTE
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
  EXPERT
}

enum PaymentMethod {
  QRIS
  DANA
  OVO
  BANK_TRANSFER
  EWALLET
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum NotificationType {
  ORDER_UPDATE
  FILE_READY
  REVISION
  DEADLINE
  PAYMENT
  PROMO
}
